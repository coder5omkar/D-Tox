<resources>
    <style name="Theme.DTox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The shield gate: appears over the gated app with no transition. -->
    <style name="Theme.DTox.Gate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dt_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
